[{"id":"the-relevant-woman-academy-rwa","title":"The Relevant Woman ACADEMY (RWA)","description":"<p class=\"mb-4 text-xl\"><strong class=\"text-[#f9f871]\">Register today and begin a journey of transformation.</strong></p><p class=\"mb-6 text-white/90\">The Relevant Woman Academy offers a comprehensive program designed to empower women through personal and professional development.</p><p class=\"mb-4 text-white/90 font-semibold\">This virtual program provides:</p><ul class=\"list-disc list-inside mb-8 space-y-3 text-white/80 ml-6\"><li class=\"mb-2\">Official Certification from The Relevant Woman Academy</li><li class=\"mb-2\">Training led by top professionals and industry experts</li><li class=\"mb-2\">Featured exposure in The Relevant Woman Magazine</li><li class=\"mb-2\">Exclusive access to partner-sponsored opportunities and awards</li></ul><p class=\"mb-4 text-white/90 font-semibold text-lg\">Key Benefits:</p><ul class=\"list-disc list-inside space-y-3 text-white/80 ml-6\"><li class=\"mb-2\">Become deeply rooted in your identity</li><li class=\"mb-2\">Master self-leadership</li><li class=\"mb-2\">Gain clarity on purpose/assignment/calling</li><li class=\"mb-2\">Acquire transferable career excellence</li><li class=\"mb-2\">Cultivate a wealthy mindset</li><li class=\"mb-2\">Develop and lead others effectively</li><li class=\"mb-2\">Become a powerful communicator and public speaker</li></ul>","category":"Education & Training","date":"2026-03-06","time":"09:00","endTime":"17:00","venue":"Virtual (Online)","location":"Virtual Event","price":0,"currency":"₦","image":"/assets/images/extras/RWA_Academy.jpg","status":"upcoming","organizer":{"name":"The Relevant Woman Academy","contact":"academy@relevantwoman.org"},"tags":["Academy","Certification","Personal Development","Professional Development","Leadership","Transformation"],"capacity":500,"registered":0,"registrationEndDate":"2026-03-06","website":"www.drelevantwoman.com","features":["Official Certification from The